# FreeSWITCH-ARM Production Readiness Checkup
# Environment Variables Template
# Copy this file to .env.checkup and configure for your environment

# =============================================================================
# Backend Configuration
# =============================================================================

# URL of the pbx-backend-core API (required for integration tests)
BACKEND_URL=http://localhost:3000

# =============================================================================
# FreeSWITCH Container Configuration
# =============================================================================

# Name of the FreeSWITCH container to test
FREESWITCH_CONTAINER=freeswitch

# FreeSWITCH image name (for build validation)
FREESWITCH_IMAGE=freeswitch-arm:latest

# =============================================================================
# Test Configuration
# =============================================================================

# Enable verbose output (true/false)
VERBOSE=false

# Output format (console/json)
OUTPUT_FORMAT=console

# =============================================================================
# Timeouts (seconds)
# =============================================================================

# Timeout for container to reach healthy status
HEALTH_TIMEOUT=90

# Timeout for HTTP requests
HTTP_TIMEOUT=10

# Timeout for graceful restart test
RESTART_TIMEOUT=30

# =============================================================================
# Performance Thresholds
# =============================================================================

# Minimum open file descriptors
MIN_OPEN_FILES=65535

# Maximum startup time (seconds)
MAX_STARTUP_TIME=90

# Maximum memory usage percentage
MAX_MEMORY_PERCENT=80

# =============================================================================
# Security Test Configuration
# =============================================================================

# Expected process user (non-root)
EXPECTED_USER=freeswitch

# Expected ports (comma-separated)
EXPECTED_PORTS=5060,5080,8021

# =============================================================================
# SIP Test Configuration (for telephony tests)
# =============================================================================

# Test extension for SIP registration
TEST_EXTENSION=1001
TEST_PASSWORD=1234

# FreeSWITCH host (for external testing)
FREESWITCH_HOST=localhost
SIP_PORT=5060
